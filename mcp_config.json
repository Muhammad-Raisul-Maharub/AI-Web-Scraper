{
  "server_name": "omniscrape-ai",
  "version": "2.1.0",
  "description": "OmniScrape AI Model Context Protocol server providing live web scraping, Pydantic structured data extraction, animation inspection, and background price monitoring.",
  "enabled_tools": [
    "scrape_page",
    "extract_structured_data",
    "extract_web_animations",
    "schedule_scrape_job",
    "list_scrape_jobs",
    "take_screenshot",
    "query_scrape_history",
    "send_webhook_alert"
  ],
  "external_mcp_servers": {
    "brave_search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "enabled": false,
      "env": {
        "BRAVE_API_KEY": ""
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": false
    }
  }
}
